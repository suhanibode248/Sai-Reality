<!-- SEARCH SECTION -->
<section class="search-section">
    <div class="container">
        <h3><i class="fa fa-search text-magenta me-2"></i> Find Your Dream Home</h3>
        <form action="properties.html" method="get">
            <div class="row g-2 mb-3">
                <div class="col-lg-3 col-md-6">
                    <select class="form-select" name="type">
                        <option value="">For Sale / Rent / Lease</option>
                        <option value="sale">For Sale</option>
                        <option value="rent">For Rent</option>
                        <option value="lease">For Lease</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <select class="form-select" name="category">
                        <option value="">All Categories</option>
                        <option value="residential">Residential Apartment</option>
                        <option value="commercial">Commercial Space</option>
                        <option value="shop">Commercial Shop</option>
                        <option value="bungalow">Bungalow</option>
                        <option value="plot">Open Plot</option>
                    </select>
                </div>
                <div class="col-lg-4 col-md-8">
                    <input type="text" class="form-control" name="query" placeholder="Search by keyword, location, project name...">
                </div>
                <div class="col-lg-2 col-md-4">
                    <button type="submit" class="btn-search btn"><i class="fa fa-search me-1"></i>Search</button>
                </div>
            </div>
        </form>
        <!-- Advance Search -->
        <div class="accordion accordion-flush" id="advSearch">
            <div class="accordion-item border-0">
                <div class="accordion-header">
                    <button class="accordion-button collapsed btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#advSearchBody">
                        <i class="fa fa-sliders-h me-2"></i> Advance Search
                    </button>
                </div>
                <div id="advSearchBody" class="accordion-collapse collapse">
                    <div class="accordion-body px-0 pt-3">
                        <form action="properties.html" method="get">
                            <div class="row g-2">
                                <div class="col-lg-2 col-md-4 col-6">
                                    <select class="form-select form-select-sm" name="location">
                                        <option value="">Location</option>
                                        <option>Dhanori</option><option>Kharadi</option><option>Lohegaon</option>
                                        <option>Wagholi</option><option>Viman Nagar</option><option>Hadapsar</option>
                                        <option>Hinjewadi</option><option>Kalyani Nagar</option><option>Yerawada</option>
                                    </select>
                                </div>
                                <div class="col-lg-2 col-md-4 col-6">
                                    <select class="form-select form-select-sm" name="bhk" multiple>
                                        <option value="1">1 BHK</option><option value="2">2 BHK</option>
                                        <option value="3">3 BHK</option><option value="4">4 BHK</option>
                                    </select>
                                </div>
                                <div class="col-lg-2 col-md-4 col-6">
                                    <select class="form-select form-select-sm" name="furnishing">
                                        <option value="">Furnishing</option>
                                        <option>Fully Furnished</option><option>Semi Furnished</option><option>Unfurnished</option>
                                    </select>
                                </div>
                                <div class="col-lg-2 col-md-4 col-6">
                                    <input type="number" class="form-control form-control-sm" name="minPrice" placeholder="Min Price (₹)">
                                </div>
                                <div class="col-lg-2 col-md-4 col-6">
                                    <input type="number" class="form-control form-control-sm" name="maxPrice" placeholder="Max Price (₹)">
                                </div>
                                <div class="col-lg-2 col-md-4 col-6">
                                    <button type="submit" class="btn btn-danger btn-sm w-100">Search</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

